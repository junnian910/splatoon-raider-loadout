# Git 与本地工具目录（绝不能部署上线）
.git/
.gitignore
.wrangler/
.dev.vars
.env
node_modules/

# 设计草稿与文档（非网站运行必需文件）
*.txt
*.md

# 构建工具脚本与测试（非网站运行必需文件）
tests/
tools-generate-plugin-data.js
tools-seed-db.js
plugin-import-manifest.json
schema.sql
seed-data.sql

# 配置文件本身（不需要部署）
wrangler.jsonc
.assetsignore

# Worker 后端代码（打包进 Worker，不需要作为静态资源部署）
worker.js
_auth.js
_plugins.js
