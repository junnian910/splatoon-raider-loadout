{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splatoon-raider-loadout",
  "compatibility_date": "2026-08-03",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "jun910.top", "custom_domain": true },
    { "pattern": "www.jun910.top", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splatoon-raider-db",
      "database_id": "d212620e-8235-497b-9f90-d0cad27e1061"
    }
  ]
}
